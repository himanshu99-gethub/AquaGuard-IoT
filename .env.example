# ==================================================================================
# AquaGuard IoT — Environment Variables Template
# ==================================================================================
# Instructions:
# 1. Copy this file and rename it to '.env'.
# 2. Fill in your real Wi-Fi credentials and Firebase keys.
# 3. '.env' is automatically ignored by git to keep your secrets private.

# ----------------------------------------------------------------------------------
# 1. ESP32 Wi-Fi Configuration
# ----------------------------------------------------------------------------------
WIFI_SSID="YOUR_WIFI_SSID"
WIFI_PASSWORD="YOUR_WIFI_PASSWORD"

# ----------------------------------------------------------------------------------
# 2. Firebase Project & Realtime Database Configuration
# ----------------------------------------------------------------------------------
FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
FIREBASE_DATABASE_URL="https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com"
FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
FIREBASE_APP_ID="YOUR_APP_ID"
FIREBASE_MEASUREMENT_ID="YOUR_MEASUREMENT_ID"

# ----------------------------------------------------------------------------------
# 3. Firebase Authentication (ESP32 User Account)
# ----------------------------------------------------------------------------------
FIREBASE_USER_EMAIL="your_email@example.com"
FIREBASE_USER_PASSWORD="your_password"
